<Window
    x:Class="DNSYar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DNSYar.Models"
    Title="DNSYar">

    <!-- Grid has no FontFamily property; a ContentControl host carries the app-wide font
         so it cascades down through the Grid to every descendant. -->
    <ContentControl x:Name="RootFontHost" FontFamily="Vazirmatn" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="RootGrid" FlowDirection="RightToLeft" SizeChanged="RootGrid_SizeChanged">
        <!-- Flat, minimal backdrop: a single subtle wash, no decorative glow shapes. -->
        <Grid x:Name="ThemeBackdrop" IsHitTestVisible="False" />

        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        CompactPaneLength="64"
                        OpenPaneLength="250"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent">

            <NavigationView.PaneHeader>
                <StackPanel Margin="12,8,12,18" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE968;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DNSYar" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Smart DNS Manager" Opacity="0.55" FontSize="10" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <Border Margin="10,8,10,14" Padding="12" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="سازنده" FontSize="10" Opacity="0.55" />
                        <TextBlock Text="سهند رضوان" FontWeight="SemiBold" FontSize="12" />
                        <HyperlinkButton Content="t.me/sahandse" NavigateUri="https://t.me/sahandse" FontSize="11" Padding="0" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="خانه" Tag="home" Icon="Home" />
                <NavigationViewItem Content="هوش مصنوعی" Tag="ai"><NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="برنامه‌نویسی" Tag="dev"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="بازی" Tag="game"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="همه DNSها" Tag="all" Icon="Globe" />
                <NavigationViewItem Content="تست سایت" Tag="site"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="تنظیمات" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <Grid Padding="20,12,20,18" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="MainInfoBar" IsOpen="False" IsClosable="True" CornerRadius="12" />

                <Grid Grid.Row="1">
                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="1320" HorizontalAlignment="Stretch" Padding="0,4,0,22">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="9" Grid.Column="0">
                                        <Border Style="{StaticResource PillBorderStyle}" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                                                <TextBlock Text="Smart DNS • Windows" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="DNS مناسب را هوشمند پیدا کن" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="سرعت، DNS Resolve و دسترسی واقعی AI، ابزارهای برنامه‌نویسی و سرویس‌های بازی را با هم مقایسه کن." Style="{StaticResource SubtleTextStyle}" MaxWidth="760" />
                                        <StackPanel x:Name="HeroButtonsPanel" Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                            <Button Content="تست همه DNSها" Click="TestAll_Click" Style="{StaticResource AccentButtonStyle}" Padding="18,10" CornerRadius="12" />
                                            <Button Content="Smart Auto الآن" Click="SmartRunNow_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                                            <Button Content="بازگشت DNS قبلی" Click="Restore_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="HeroVisual" Grid.Column="1" Width="44" Height="44" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE968;" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <GridView SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridViewItem Width="292" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource CardBorderStyle}" Width="280">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5"><TextBlock Text="DNS فعال" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="CurrentDnsText" Text="—" Style="{StaticResource MetricValueStyle}" TextTrimming="CharacterEllipsis" MaxWidth="205"/></StackPanel>
                                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="13" Background="#1822C55E"><FontIcon Glyph="&#xE701;" Foreground="#22C55E" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                        </Grid>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="292" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource CardBorderStyle}" Width="280">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5"><TextBlock Text="بهترین امتیاز" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="BestScoreText" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel>
                                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="13" Background="#1806B6D4"><FontIcon Glyph="&#xE9D2;" Foreground="#06B6D4" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                        </Grid>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="292" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource CardBorderStyle}" Width="280">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5"><TextBlock Text="کارت شبکه" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="AdapterSummaryText" Text="—" Style="{StaticResource MetricValueStyle}" TextTrimming="CharacterEllipsis" MaxWidth="205"/></StackPanel>
                                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="13" Background="#18256BEB"><FontIcon Glyph="&#xE968;" Foreground="#60A5FA" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                        </Grid>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="292" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource CardBorderStyle}" Width="280">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5"><TextBlock Text="DNSهای موجود" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="ProviderCountText" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel>
                                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="13" Background="#18A855F7"><FontIcon Glyph="&#xE8EF;" Foreground="#C084FC" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                        </Grid>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="292" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource CardBorderStyle}" Width="280">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5"><TextBlock Text="Smart Auto DNS" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="HomeSmartAutoText" Text="خاموش" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="205"/></StackPanel>
                                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="13" Background="#1822C55E"><FontIcon Glyph="&#xE768;" Foreground="#34D399" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                        </Grid>
                                    </Border>
                                </GridViewItem>
                            </GridView>

                            <Grid x:Name="HomeSplitGrid" ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="RecommendationCard" Style="{StaticResource CardBorderStyle}" Padding="22">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="8" Height="8" Fill="#22C55E"/><TextBlock Text="پیشنهاد هوشمند" Opacity="0.65"/></StackPanel>
                                            <TextBlock x:Name="BestNameText" Text="هنوز تست انجام نشده" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="BestRecommendationText" Text="روی «تست همه DNSها» بزن تا بهترین گزینه مشخص شود." TextWrapping="Wrap" Opacity="0.76" />
                                            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,5,0,0">
                                                <TextBlock x:Name="BestPingText" Text="Ping: —" />
                                                <TextBlock x:Name="BestDnsText" Text="DNS: —" />
                                                <TextBlock x:Name="BestServicesText" Text="Services: —" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="اتصال" Click="ConnectBest_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,10" CornerRadius="12" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border x:Name="AdapterCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE968;"/><TextBlock Text="کارت شبکه" Style="{StaticResource SectionTitleStyle}"/></StackPanel>
                                        <TextBlock Text="DNS روی کارت انتخاب‌شده اعمال می‌شود." Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                                        <ComboBox x:Name="AdapterCombo" DisplayMemberPath="Display" SelectionChanged="AdapterCombo_SelectionChanged" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="10">
                                <TextBlock Text="پوشش تست سرویس‌ها" Style="{StaticResource SectionTitleStyle}" />
                                <GridView SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridViewItem Width="300" Margin="0,0,10,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="288"><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE99A;" Foreground="#A78BFA"/><TextBlock Text="هوش مصنوعی" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="AiTargetCountText" Text="—" FontSize="13" Opacity="0.68"/></StackPanel></Border></GridViewItem>
                                    <GridViewItem Width="300" Margin="0,0,10,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="288"><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE943;" Foreground="#22D3EE"/><TextBlock Text="برنامه‌نویسی" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="DevTargetCountText" Text="—" FontSize="13" Opacity="0.68"/></StackPanel></Border></GridViewItem>
                                    <GridViewItem Width="300" Margin="0,0,10,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="288"><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7FC;" Foreground="#34D399"/><TextBlock Text="بازی" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="GameTargetCountText" Text="—" FontSize="13" Opacity="0.68"/></StackPanel></Border></GridViewItem>
                                </GridView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- DNS LIST / AI / DEV / GAME -->
                    <Grid x:Name="ListPage" Visibility="Collapsed" RowSpacing="12" MaxWidth="1320" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="ListTitle" Text="همه DNSها" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Name="ListSubtitle" Text="نتایج بر اساس امتیاز مرتب می‌شوند." Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock x:Name="ListCoverageText" Text="" FontSize="12" Opacity="0.52" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="+ DNS دستی" Click="AddCustomDns_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Content="تست این بخش" Click="TestVisible_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,9" CornerRadius="12" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ServiceShowcaseCard" Grid.Row="1" Style="{StaticResource SoftCardBorderStyle}" Padding="14" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Border x:Name="ServiceShowcaseIconBadge" Width="30" Height="30" CornerRadius="10">
                                        <FontIcon x:Name="ServiceShowcaseIcon" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ServiceShowcaseTitle" Text="سرویس‌های پوشش‌داده‌شده" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                                </StackPanel>
                                <GridView x:Name="ServiceShowcase" SelectionMode="None" IsItemClickEnabled="False" Padding="0"
                                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Margin" Value="0,0,4,4" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ServiceShowcaseItem">
                                            <StackPanel Width="78" Spacing="6" HorizontalAlignment="Center">
                                                <Border Width="50" Height="50" CornerRadius="15" Background="{x:Bind Badge}" HorizontalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Initials}" Foreground="White" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource SoftCardBorderStyle}" Padding="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DnsSearchBox" PlaceholderText="جستجو بین DNSها؛ نام یا IP..." TextChanged="DnsSearchBox_TextChanged" CornerRadius="10" />
                                <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="#22C55E"/><TextBlock Text="سبز = دسترسی موفق" FontSize="11"/></StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ListView x:Name="DnsList" Grid.Row="3" SelectionMode="None" Padding="0,2,0,20">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DnsProvider">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="9">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                                        <Ellipse Width="9" Height="9" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="20" FontWeight="SemiBold" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{x:Bind ActiveBrush, Mode=OneWay}"/>
                                                            <TextBlock Text="{x:Bind ActiveText, Mode=OneWay}" FontSize="10" Opacity="0.65"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="12" Padding="10,6" Background="{x:Bind ScoreBrush, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind ScoreText, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Addresses}" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontSize="13" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind SourceText, Mode=OneWay}" FontSize="11" Opacity="0.52" />
                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Recommendation, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.74" />
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="11,8">
                                                    <TextBlock Text="{x:Bind ServiceDetailsText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <StackPanel><TextBlock Text="Ping" FontSize="10" Opacity="0.5"/><TextBlock Text="{x:Bind PingText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <StackPanel><TextBlock Text="DNS" FontSize="10" Opacity="0.5"/><TextBlock Text="{x:Bind DnsText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <StackPanel><TextBlock Text="Loss" FontSize="10" Opacity="0.5"/><TextBlock Text="{x:Bind LossText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <StackPanel><TextBlock Text="Services" FontSize="10" Opacity="0.5"/><TextBlock Text="{x:Bind ServiceText, Mode=OneWay}" Foreground="{x:Bind ServiceBrush, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="95">
                                                <Button Content="اتصال" Click="ConnectProvider_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8" CornerRadius="11" HorizontalAlignment="Stretch" />
                                                <Button Content="تست" Click="TestProvider_Click" Style="{StaticResource SecondaryActionButtonStyle}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- WEBSITE DNS TEST -->
                    <Grid x:Name="SiteTestPage" Visibility="Collapsed" RowSpacing="14" MaxWidth="1320" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border CornerRadius="24" Padding="22" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="9">
                                <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="40" Height="40" CornerRadius="13" Background="#18256BEB"><FontIcon Glyph="&#xE774;" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="تست سایت با همه DNSها" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="بدون تغییر DNS فعلی ویندوز" Opacity="0.55" FontSize="11"/></StackPanel></StackPanel>
                                <TextBlock Text="دامنه را وارد کن؛ هر DNS جداگانه Resolve و سپس اتصال واقعی HTTP/HTTPS بررسی می‌شود." Style="{StaticResource SubtleTextStyle}" />
                                <Grid ColumnSpacing="10" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SiteAddressBox" PlaceholderText="google.com یا https://chatgpt.com" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" FontFamily="Consolas" CornerRadius="12" />
                                    <Button x:Name="SiteTestButton" Grid.Column="1" Content="تست همه DNSها" Click="TestSite_Click" Style="{StaticResource AccentButtonStyle}" Padding="18,10" CornerRadius="12" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <GridView Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridViewItem Width="245" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource CardBorderStyle}" Width="233"><StackPanel Spacing="4"><TextBlock Text="تست‌شده" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteTestedCountText" Text="0" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></GridViewItem>
                            <GridViewItem Width="245" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource CardBorderStyle}" Width="233"><StackPanel Spacing="4"><TextBlock Text="قابل دسترسی" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteGreenCountText" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#22C55E"/></StackPanel></Border></GridViewItem>
                            <GridViewItem Width="245" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource CardBorderStyle}" Width="233"><StackPanel Spacing="4"><TextBlock Text="ناموفق" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteRedCountText" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#EF4444"/></StackPanel></Border></GridViewItem>
                            <GridViewItem Width="300" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource CardBorderStyle}" Width="288"><StackPanel Spacing="4"><TextBlock Text="سریع‌ترین DNS موفق" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteFastestText" Text="—" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel></Border></GridViewItem>
                        </GridView>

                        <Grid Grid.Row="2">
                            <ListView x:Name="SiteTestList" SelectionMode="None" Padding="0,2,0,20">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SiteDnsTestResult">
                                        <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{x:Bind CardBrush, Mode=OneWay}" BorderThickness="2">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="7">
                                                    <StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush, Mode=OneWay}"/><TextBlock Text="{x:Bind ProviderName}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <TextBlock Text="{x:Bind Addresses}" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal" Spacing="18"><TextBlock Text="{x:Bind DnsText, Mode=OneWay}"/><TextBlock Text="{x:Bind HttpText, Mode=OneWay}"/></StackPanel>
                                                    <TextBlock Text="{x:Bind ResolvedText, Mode=OneWay}" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.68" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="اتصال" Click="ConnectSiteResult_Click" Style="{StaticResource AccentButtonStyle}" Padding="15,8" CornerRadius="11" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel x:Name="SiteEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <Border Width="74" Height="74" CornerRadius="24" Background="#18256BEB"><FontIcon Glyph="&#xE774;" FontSize="30" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="یک آدرس مثل google.com وارد کن" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="نتیجه هر DNS زنده به‌صورت سبز یا قرمز نمایش داده می‌شود." Opacity="0.58" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="1050" HorizontalAlignment="Stretch" Padding="0,4,0,24">
                            <StackPanel Spacing="4"><TextBlock Text="تنظیمات" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="ظاهر، بروزرسانی، DNS دستی و بازگردانی امن" Style="{StaticResource SubtleTextStyle}"/></StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="9"><Border Width="38" Height="38" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><FontIcon Glyph="&#xE790;" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="ظاهر برنامه" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="فونت و تم رنگی" FontSize="11" Opacity="0.55"/></StackPanel></StackPanel>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="فونت رابط کاربری" Opacity="0.68"/><ComboBox x:Name="FontCombo" SelectionChanged="FontCombo_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="Vazirmatn"/><ComboBoxItem Content="IRANSans"/><ComboBoxItem Content="Segoe UI"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="تم فعال" Opacity="0.68"/><Border Style="{StaticResource SoftCardBorderStyle}" Padding="10"><TextBlock x:Name="ThemeNameText" Text="روشن" FontWeight="SemiBold"/></Border></StackPanel></Grid>
                                    <TextBlock Text="Vazirmatn و IRANSans باید روی ویندوز نصب باشند. فایل فونت داخل پروژه توزیع نشده است." FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                                    <GridView SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                                        <Button Width="140" Margin="0,0,8,8" Tag="Glass3D" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}"><StackPanel Spacing="7"><Border Height="40" Width="113" CornerRadius="10" Background="#F1F3F6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/><TextBlock Text="روشن" HorizontalAlignment="Center"/></StackPanel></Button>
                                        <Button Width="140" Margin="0,0,8,8" Tag="Aurora" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}"><StackPanel Spacing="7"><Border Height="40" Width="113" CornerRadius="10" Background="#10141F"/><TextBlock Text="Aurora" HorizontalAlignment="Center"/></StackPanel></Button>
                                        <Button Width="140" Margin="0,0,8,8" Tag="CyberNeon" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}"><StackPanel Spacing="7"><Border Height="40" Width="113" CornerRadius="10" Background="#12111A"/><TextBlock Text="Neon" HorizontalAlignment="Center"/></StackPanel></Button>
                                        <Button Width="140" Margin="0,0,8,8" Tag="OceanDepth" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}"><StackPanel Spacing="7"><Border Height="40" Width="113" CornerRadius="10" Background="#0B2130"/><TextBlock Text="Ocean" HorizontalAlignment="Center"/></StackPanel></Button>
                                        <Button Width="140" Margin="0,0,8,8" Tag="Graphite3D" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}"><StackPanel Spacing="7"><Border Height="40" Width="113" CornerRadius="10" Background="#191C22"/><TextBlock Text="Graphite" HorizontalAlignment="Center"/></StackPanel></Button>
                                    </GridView>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#1822C55E"><FontIcon Glyph="&#xE768;" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel><TextBlock Text="Smart Auto DNS + Failover" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="پایش DNS فعال و سوییچ خودکار فقط هنگام افت واقعی کیفیت" FontSize="11" Opacity="0.55"/></StackPanel>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SmartAutoToggle" Header="انتخاب و Failover خودکار DNS" Toggled="SmartAutoToggle_Toggled"/>
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Spacing="5"><TextBlock Text="پروفایل هوشمند" Opacity="0.68"/><ComboBox x:Name="SmartProfileCombo" SelectionChanged="SmartProfileCombo_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="همه‌کاره" Tag="all"/><ComboBoxItem Content="هوش مصنوعی" Tag="ai"/><ComboBoxItem Content="برنامه‌نویسی" Tag="dev"/><ComboBoxItem Content="بازی" Tag="game"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="فاصله بررسی" Opacity="0.68"/><ComboBox x:Name="SmartIntervalCombo" SelectionChanged="SmartIntervalCombo_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="هر ۵ دقیقه" Tag="5"/><ComboBoxItem Content="هر ۱۰ دقیقه" Tag="10"/><ComboBoxItem Content="هر ۱۵ دقیقه" Tag="15"/><ComboBoxItem Content="هر ۳۰ دقیقه" Tag="30"/><ComboBoxItem Content="هر ۶۰ دقیقه" Tag="60"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="حداقل امتیاز DNS جایگزین" Opacity="0.68"/><ComboBox x:Name="SmartMinimumScoreCombo" SelectionChanged="SmartMinimumScoreCombo_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="۵۵ از ۱۰۰" Tag="55"/><ComboBoxItem Content="۶۵ از ۱۰۰" Tag="65"/><ComboBoxItem Content="۷۵ از ۱۰۰" Tag="75"/><ComboBoxItem Content="۸۵ از ۱۰۰" Tag="85"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Failover بعد از چند افت متوالی" Opacity="0.68"/><ComboBox x:Name="SmartFailuresCombo" SelectionChanged="SmartFailuresCombo_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="۱ بار" Tag="1"/><ComboBoxItem Content="۲ بار" Tag="2"/><ComboBoxItem Content="۳ بار" Tag="3"/></ComboBox></StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource SoftCardBorderStyle}" Padding="12">
                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="وضعیت پایش" FontSize="11" Opacity="0.55"/><TextBlock x:Name="SmartAutoStatusText" Text="خاموش • همه‌کاره • آماده" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="بررسی و انتخاب الآن" Click="SmartRunNow_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8" CornerRadius="11" VerticalAlignment="Center"/></Grid>
                                    </Border>
                                    <TextBlock Text="برای جلوگیری از سوییچ بی‌دلیل، ابتدا فقط DNS فعال تست می‌شود. اگر چند بار پشت‌سرهم افت کند، همه گزینه‌های مناسب همان پروفایل تست و بهترین DNS سالم جایگزین می‌شود." Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="11">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="#18256BEB"><FontIcon Glyph="&#xE7E8;" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel><TextBlock Text="System Tray + Quick Switch" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="کنترل سریع DNS از کنار ساعت ویندوز" FontSize="11" Opacity="0.55"/></StackPanel>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TrayEnabledToggle" Header="آیکن DNSYar در System Tray نمایش داده شود" Toggled="TrayEnabledToggle_Toggled"/>
                                    <ToggleSwitch x:Name="CloseToTrayToggle" Header="دکمه × فقط برنامه را به Tray بفرستد و DNS فعال بماند" Toggled="CloseToTrayToggle_Toggled"/>
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="12" Title="رفتار خروج" Message="این گزینه پیش‌فرض خاموش است. وقتی خاموش باشد، × یعنی خروج کامل و طبق تنظیم قبلی DNS بازیابی می‌شود. وقتی روشن باشد، × فقط پنجره را مخفی می‌کند؛ «خروج کامل از DNSYar» در Tray همچنان DNS قبلی را بازیابی می‌کند."/>
                                    <TextBlock Text="منوی Tray شامل: DNS فعال، Quick Switch تا ۱۰ گزینه برتر، روشن/خاموش کردن Smart Auto، بررسی هوشمند الآن، بازگردانی DNS قبلی و خروج کامل است." Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="11">
                                    <StackPanel Orientation="Horizontal" Spacing="9"><Border Width="38" Height="38" CornerRadius="12" Background="#1806B6D4"><FontIcon Glyph="&#xE895;" Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="بروزرسانی DNS از GitHub" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Merge امن با DNSهای موجود" FontSize="11" Opacity="0.55"/></StackPanel></StackPanel>
                                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="DNSهای جدید را خودکار از GitHub دریافت کن" Toggled="AutoUpdateToggle_Toggled"/>
                                    <TextBlock Text="DNSهای دستی کاربر با بروزرسانی GitHub حذف یا جایگزین نمی‌شوند." Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="آدرس فایل GitHub — JSON یا TXT" Opacity="0.68"/><TextBox x:Name="UpdateUrlBox" PlaceholderText="https://github.com/.../blob/main/dns.json" TextChanged="UpdateUrlBox_TextChanged" FlowDirection="LeftToRight" CornerRadius="10"/></StackPanel><Button Grid.Column="1" Content="منبع پیش‌فرض" Click="ResetGithubSource_Click" VerticalAlignment="Bottom" Style="{StaticResource SecondaryActionButtonStyle}"/></Grid>
                                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="فاصله بروزرسانی" Opacity="0.68"/><ComboBox x:Name="UpdateIntervalCombo" SelectionChanged="UpdateIntervalCombo_SelectionChanged" MinWidth="175"><ComboBoxItem Content="هر ۶ ساعت" Tag="6"/><ComboBoxItem Content="هر ۱۲ ساعت" Tag="12"/><ComboBoxItem Content="هر ۲۴ ساعت" Tag="24"/><ComboBoxItem Content="هر ۳ روز" Tag="72"/></ComboBox></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="3"><TextBlock Text="منبع پیش‌فرض: Iran-DNS-Switcher / dns_servers.txt" FontSize="11" Opacity="0.55" TextWrapping="Wrap"/><TextBlock x:Name="LastUpdateText" Text="آخرین بروزرسانی: —" FontSize="11" Opacity="0.7"/></StackPanel></Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="بررسی بروزرسانی الآن" Click="ManualUpdate_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8" CornerRadius="11"/><Button Content="+ افزودن DNS دستی" Click="AddCustomDns_Click" Style="{StaticResource SecondaryActionButtonStyle}"/></StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="11">
                                    <StackPanel Orientation="Horizontal" Spacing="9"><Border Width="38" Height="38" CornerRadius="12" Background="#1822C55E"><FontIcon Glyph="&#xE72E;" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="بازگردانی امن شبکه" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="حفظ تنظیم DNS قبل از اجرای DNSYar" FontSize="11" Opacity="0.55"/></StackPanel></StackPanel>
                                    <ToggleSwitch x:Name="RestoreOnExitToggle" Header="پس از بستن برنامه یا خاموش/ری‌استارت ویندوز، DNS قبلی را برگردان" Toggled="RestoreOnExitToggle_Toggled"/>
                                    <ToggleSwitch x:Name="CrashRecoveryToggle" Header="اگر برنامه ناگهانی بسته شد، در اجرای بعدی DNS قبلی را بازیابی کن" Toggled="CrashRecoveryToggle_Toggled"/>
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="12" Title="نکته" Message="DNSYar قبل از اولین تغییر، تنظیم واقعی کارت شبکه را ذخیره می‌کند؛ DNS دستی قبلی دقیقاً برمی‌گردد و اگر حالت DHCP بوده، دوباره DHCP فعال می‌شود."/>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="بازگشت کارت انتخابی" Click="Restore_Click" Style="{StaticResource SecondaryActionButtonStyle}"/><Button Content="بازگردانی همه" Click="RestoreAll_Click" Style="{StaticResource SecondaryActionButtonStyle}"/></StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="درباره DNSYar" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="مدیریت هوشمند DNS برای ویندوز" Opacity="0.6"/><TextBlock Text="سازنده: سهند رضوان" FontWeight="SemiBold"/></StackPanel><HyperlinkButton Grid.Column="1" Content="t.me/sahandse" NavigateUri="https://t.me/sahandse" VerticalAlignment="Center"/></Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#52000000">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260">
                            <StackPanel Spacing="12" HorizontalAlignment="Center"><ProgressRing IsActive="True" Width="42" Height="42"/><TextBlock x:Name="BusyText" Text="در حال تست…" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
    </ContentControl>
</Window>
