<Window
    x:Class="DNSYar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DNSYar.Models"
    Title="DNSYar">

    <ContentControl x:Name="RootFontHost" FontFamily="{StaticResource VazirmatnFont}" FlowDirection="RightToLeft"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="RootGrid" FlowDirection="RightToLeft" SizeChanged="RootGrid_SizeChanged">
        <Grid x:Name="ThemeBackdrop" IsHitTestVisible="False">
            <Rectangle x:Name="AccentSlab" Width="420" Height="420" RadiusX="36" RadiusY="36"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-220,0,0" Opacity="0.18"/>
            <Rectangle Width="240" Height="240" RadiusX="24" RadiusY="24"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-90" Opacity="0.10"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
        </Grid>

        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        CompactPaneLength="64"
                        OpenPaneLength="236"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent">

            <NavigationView.PaneHeader>
                <StackPanel Margin="12,10,12,14" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE968;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DNSYar" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="BrandKickerText" Text="{x:Bind T.BrandKicker, Mode=OneWay}" Opacity="0.5" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Border CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="LanguageFaButton" Content="{x:Bind T.LangFa, Mode=OneWay}" Click="LanguageFa_Click" Style="{StaticResource LangButtonStyle}"/>
                            <Button x:Name="LanguageEnButton" Content="{x:Bind T.LangEn, Mode=OneWay}" Click="LanguageEn_Click" Style="{StaticResource LangButtonStyle}" FontFamily="{StaticResource InterFont}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <Border Margin="10,8,10,14" Padding="12" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind T.Creator, Mode=OneWay}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{x:Bind T.AuthorName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <HyperlinkButton Content="t.me/sahandse" NavigateUri="https://t.me/sahandse" FontSize="11" Padding="0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHomeItem" Content="{x:Bind T.NavHome, Mode=OneWay}" Tag="home" Icon="Home" />
                <NavigationViewItem x:Name="NavAiItem" Content="{x:Bind T.NavAi, Mode=OneWay}" Tag="ai"><NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavDevItem" Content="{x:Bind T.NavDev, Mode=OneWay}" Tag="dev"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavGameItem" Content="{x:Bind T.NavGame, Mode=OneWay}" Tag="game"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavAllItem" Content="{x:Bind T.NavAll, Mode=OneWay}" Tag="all" Icon="Globe" />
                <NavigationViewItem x:Name="NavSiteItem" Content="{x:Bind T.NavSite, Mode=OneWay}" Tag="site"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavSettingsItem" Content="{x:Bind T.NavSettings, Mode=OneWay}" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <Grid Padding="24,16,24,18" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="MainInfoBar" IsOpen="False" IsClosable="True" CornerRadius="10" />

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18" MaxWidth="1080" HorizontalAlignment="Stretch" Padding="0,2,0,28">
                            <Grid ColumnSpacing="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind T.HeroKicker, Mode=OneWay}" Style="{StaticResource KickerStyle}"/>
                                    <TextBlock Text="{x:Bind T.HeroTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" FontSize="34"/>
                                    <Border Width="48" Height="3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                                    <TextBlock Text="{x:Bind T.HeroSubtitle, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" MaxWidth="560" FontSize="14"/>
                                    <StackPanel x:Name="HeroActions" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button Content="{x:Bind T.TestAll, Mode=OneWay}" Click="TestAll_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="{x:Bind T.SmartNow, Mode=OneWay}" Click="SmartRunNow_Click" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        <Button Content="{x:Bind T.RestoreDns, Mode=OneWay}" Click="Restore_Click" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="HeroVisual" Grid.Column="1" Width="176" Height="140" CornerRadius="24"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Canvas Width="168" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Line X1="24" Y1="66" X2="84" Y2="28" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" Opacity="0.55"/>
                                        <Line X1="24" Y1="66" X2="84" Y2="104" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" Opacity="0.55"/>
                                        <Line X1="84" Y1="28" X2="144" Y2="66" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" Opacity="0.55"/>
                                        <Line X1="84" Y1="104" X2="144" Y2="66" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" Opacity="0.55"/>
                                        <Ellipse Width="14" Height="14" Canvas.Left="17" Canvas.Top="59" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <Ellipse Width="10" Height="10" Canvas.Left="79" Canvas.Top="23" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.55"/>
                                        <Ellipse Width="10" Height="10" Canvas.Left="79" Canvas.Top="99" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.55"/>
                                        <Ellipse Width="18" Height="18" Canvas.Left="135" Canvas.Top="57" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"/>
                                    </Canvas>
                                </Border>
                            </Grid>

                            <GridView SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5"/></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridViewItem Width="196" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource MetricCardStyle}" Width="184">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.MetricActive, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/>
                                            <TextBlock x:Name="CurrentDnsText" Text="—" Style="{StaticResource MetricValueStyle}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="196" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource MetricCardStyle}" Width="184">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.MetricScore, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/>
                                            <TextBlock x:Name="BestScoreText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="196" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource MetricCardStyle}" Width="184">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.MetricAdapter, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/>
                                            <TextBlock x:Name="AdapterSummaryText" Text="—" Style="{StaticResource MetricValueStyle}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="196" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource MetricCardStyle}" Width="184">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.MetricProviders, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/>
                                            <TextBlock x:Name="ProviderCountText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </GridViewItem>
                                <GridViewItem Width="196" Margin="0,0,10,10" IsTabStop="False">
                                    <Border Style="{StaticResource MetricCardStyle}" Width="184">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.MetricSmart, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/>
                                            <TextBlock x:Name="HomeSmartAutoText" Text="—" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </GridViewItem>
                            </GridView>

                            <Grid x:Name="HomeSplitGrid" ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="RecommendationCard" Style="{StaticResource CardBorderStyle}" Padding="20">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind T.Recommend, Mode=OneWay}" Style="{StaticResource KickerStyle}"/>
                                            <TextBlock x:Name="BestNameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="BestRecommendationText" Style="{StaticResource SubtleTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                                <TextBlock x:Name="BestPingText" Text="Ping: —" Opacity="0.7" FontSize="12"/>
                                                <TextBlock x:Name="BestDnsText" Text="DNS: —" Opacity="0.7" FontSize="12"/>
                                                <TextBlock x:Name="BestServicesText" Text="Services: —" Opacity="0.7" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="ConnectBestButton" Grid.Column="1" Content="{x:Bind T.Connect, Mode=OneWay}" Click="ConnectBest_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border x:Name="AdapterCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind T.AdapterTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{x:Bind T.AdapterHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                        <ComboBox x:Name="AdapterCombo" DisplayMemberPath="Display" SelectionChanged="AdapterCombo_SelectionChanged" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind T.Coverage, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCardBorderStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.NavAi, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="AiTargetCountText" Text="—" FontSize="13" Opacity="0.62"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SoftCardBorderStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.NavDev, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DevTargetCountText" Text="—" FontSize="13" Opacity="0.62"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCardBorderStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind T.NavGame, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="GameTargetCountText" Text="—" FontSize="13" Opacity="0.62"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ListPage" Visibility="Collapsed" RowSpacing="12" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ListTitle" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Name="ListSubtitle" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock x:Name="ListCoverageText" Text="" FontSize="12" Opacity="0.48" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="{x:Bind T.AddCustom, Mode=OneWay}" Click="AddCustomDns_Click" Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button Content="{x:Bind T.TestSection, Mode=OneWay}" Click="TestVisible_Click" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource SoftCardBorderStyle}" Padding="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DnsSearchBox" PlaceholderText="{x:Bind T.SearchPlaceholder, Mode=OneWay}" TextChanged="DnsSearchBox_TextChanged" CornerRadius="8" />
                                <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind T.GreenMeansOk, Mode=OneWay}" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ListView x:Name="DnsList" Grid.Row="2" SelectionMode="None" Padding="0,2,0,20">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DnsProvider">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind ActiveText, Mode=OneWay}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Background="{x:Bind ScoreBrush, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind ScoreText, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Addresses}" FontFamily="Cascadia Mono, Consolas" FlowDirection="LeftToRight" FontSize="13" Opacity="0.75" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind SourceText, Mode=OneWay}" FontSize="11" Opacity="0.48" />
                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Recommendation, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" FontSize="13" />
                                                <TextBlock Text="{x:Bind ServiceDetailsText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" LineHeight="20" />
                                                <StackPanel Orientation="Horizontal" Spacing="18">
                                                    <StackPanel><TextBlock Text="{Binding LabelPing, Source={StaticResource T}}" FontSize="10" Opacity="0.45"/><TextBlock Text="{x:Bind PingText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <StackPanel><TextBlock Text="{Binding LabelDns, Source={StaticResource T}}" FontSize="10" Opacity="0.45"/><TextBlock Text="{x:Bind DnsText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <StackPanel><TextBlock Text="{Binding LabelLoss, Source={StaticResource T}}" FontSize="10" Opacity="0.45"/><TextBlock Text="{x:Bind LossText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                    <StackPanel><TextBlock Text="{Binding LabelServices, Source={StaticResource T}}" FontSize="10" Opacity="0.45"/><TextBlock Text="{x:Bind ServiceText, Mode=OneWay}" Foreground="{x:Bind ServiceBrush, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="92">
                                                <Button Content="{Binding Connect, Source={StaticResource T}}" Click="ConnectProvider_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,7" HorizontalAlignment="Stretch" />
                                                <Button Content="{Binding Test, Source={StaticResource T}}" Click="TestProvider_Click" Style="{StaticResource SecondaryActionButtonStyle}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="SiteTestPage" Visibility="Collapsed" RowSpacing="14" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind T.SiteKicker, Mode=OneWay}" Style="{StaticResource KickerStyle}"/>
                                <TextBlock Text="{x:Bind T.SiteTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="{x:Bind T.SiteHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" />
                                <Grid ColumnSpacing="10" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SiteAddressBox" PlaceholderText="{x:Bind T.SitePlaceholder, Mode=OneWay}" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" FontFamily="Cascadia Mono, Consolas" CornerRadius="10" />
                                    <Button x:Name="SiteTestButton" Grid.Column="1" Content="{x:Bind T.TestAll, Mode=OneWay}" Click="TestSite_Click" Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <GridView Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridViewItem Width="200" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="188"><StackPanel Spacing="2"><TextBlock Text="{x:Bind T.SiteTested, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteTestedCountText" Text="0" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></GridViewItem>
                            <GridViewItem Width="200" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="188"><StackPanel Spacing="2"><TextBlock Text="{x:Bind T.SiteReachable, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteGreenCountText" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#16A34A"/></StackPanel></Border></GridViewItem>
                            <GridViewItem Width="200" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="188"><StackPanel Spacing="2"><TextBlock Text="{x:Bind T.SiteFailed, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteRedCountText" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#DC2626"/></StackPanel></Border></GridViewItem>
                            <GridViewItem Width="260" Margin="0,0,8,8" IsTabStop="False"><Border Style="{StaticResource SoftCardBorderStyle}" Width="248"><StackPanel Spacing="2"><TextBlock Text="{x:Bind T.SiteFastest, Mode=OneWay}" Style="{StaticResource MetricTitleStyle}"/><TextBlock x:Name="SiteFastestText" Text="—" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Border></GridViewItem>
                        </GridView>

                        <Grid Grid.Row="2">
                            <ListView x:Name="SiteTestList" SelectionMode="None" Padding="0,2,0,20">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SiteDnsTestResult">
                                        <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{x:Bind CardBrush, Mode=OneWay}" BorderThickness="1.5">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneWay}"/>
                                                        <TextBlock Text="{x:Bind ProviderName}" FontSize="17" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Addresses}" FlowDirection="LeftToRight" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{x:Bind DnsText, Mode=OneWay}" Opacity="0.7"/><TextBlock Text="{x:Bind HttpText, Mode=OneWay}" Opacity="0.7"/></StackPanel>
                                                    <TextBlock Text="{x:Bind ResolvedText, Mode=OneWay}" FlowDirection="LeftToRight" FontFamily="Cascadia Mono, Consolas" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.65" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding Connect, Source={StaticResource T}}" Click="ConnectSiteResult_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,7" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel x:Name="SiteEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="{x:Bind T.SiteEmptyTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind T.SiteEmptyHint, Mode=OneWay}" Opacity="0.55" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                        <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch" Padding="0,2,0,28">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind T.SettingsTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="{x:Bind T.SettingsSubtitle, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}"/>
                            </StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind T.LanguageTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind T.LanguageHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SettingsLanguageFaButton" Content="{x:Bind T.LangFa, Mode=OneWay}" Click="LanguageFa_Click" Style="{StaticResource LangButtonStyle}"/>
                                        <Button x:Name="SettingsLanguageEnButton" Content="{x:Bind T.LangEn, Mode=OneWay}" Click="LanguageEn_Click" Style="{StaticResource LangButtonStyle}" FontFamily="{StaticResource InterFont}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind T.AppearanceTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind T.AppearanceHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind T.FontLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <ComboBox x:Name="FontCombo" SelectionChanged="FontCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Tag="Auto" Content="{x:Bind T.FontAuto, Mode=OneWay}"/>
                                                <ComboBoxItem Tag="Vazirmatn" Content="Vazirmatn"/>
                                                <ComboBoxItem Tag="Inter" Content="Inter"/>
                                                <ComboBoxItem Tag="Segoe UI" Content="Segoe UI"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind T.ThemeLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <Border Style="{StaticResource SoftCardBorderStyle}" Padding="10">
                                                <TextBlock x:Name="ThemeNameText" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind T.FontHint, Mode=OneWay}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Tag="Paper" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}" Padding="10">
                                            <StackPanel Spacing="6">
                                                <Border Width="92" Height="36" CornerRadius="8" Background="#F3F0E8" BorderBrush="#D7D2C6" BorderThickness="1"/>
                                                <TextBlock Text="{x:Bind T.ThemePaper, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="Ink" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}" Padding="10">
                                            <StackPanel Spacing="6">
                                                <Border Width="92" Height="36" CornerRadius="8" Background="#121417"/>
                                                <TextBlock Text="{x:Bind T.ThemeInk, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="Signal" Click="ThemeButton_Click" Style="{StaticResource SecondaryActionButtonStyle}" Padding="10">
                                            <StackPanel Spacing="6">
                                                <Border Width="92" Height="36" CornerRadius="8" Background="#0B1C1A"/>
                                                <TextBlock Text="{x:Bind T.ThemeSignal, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind T.SmartTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind T.SmartHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <ToggleSwitch x:Name="SmartAutoToggle" Header="{x:Bind T.SmartToggle, Mode=OneWay}" Toggled="SmartAutoToggle_Toggled"/>
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind T.ProfileLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <ComboBox x:Name="SmartProfileCombo" SelectionChanged="SmartProfileCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{x:Bind T.ProfileAll, Mode=OneWay}" Tag="all"/>
                                                <ComboBoxItem Content="{x:Bind T.ProfileAi, Mode=OneWay}" Tag="ai"/>
                                                <ComboBoxItem Content="{x:Bind T.ProfileDev, Mode=OneWay}" Tag="dev"/>
                                                <ComboBoxItem Content="{x:Bind T.ProfileGame, Mode=OneWay}" Tag="game"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind T.IntervalLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <ComboBox x:Name="SmartIntervalCombo" SelectionChanged="SmartIntervalCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{x:Bind T.Interval5, Mode=OneWay}" Tag="5"/>
                                                <ComboBoxItem Content="{x:Bind T.Interval10, Mode=OneWay}" Tag="10"/>
                                                <ComboBoxItem Content="{x:Bind T.Interval15, Mode=OneWay}" Tag="15"/>
                                                <ComboBoxItem Content="{x:Bind T.Interval30, Mode=OneWay}" Tag="30"/>
                                                <ComboBoxItem Content="{x:Bind T.Interval60, Mode=OneWay}" Tag="60"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="5">
                                            <TextBlock Text="{x:Bind T.MinScoreLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <ComboBox x:Name="SmartMinimumScoreCombo" SelectionChanged="SmartMinimumScoreCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{x:Bind T.Score55, Mode=OneWay}" Tag="55"/>
                                                <ComboBoxItem Content="{x:Bind T.Score65, Mode=OneWay}" Tag="65"/>
                                                <ComboBoxItem Content="{x:Bind T.Score75, Mode=OneWay}" Tag="75"/>
                                                <ComboBoxItem Content="{x:Bind T.Score85, Mode=OneWay}" Tag="85"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind T.FailuresLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <ComboBox x:Name="SmartFailuresCombo" SelectionChanged="SmartFailuresCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{x:Bind T.Failures1, Mode=OneWay}" Tag="1"/>
                                                <ComboBoxItem Content="{x:Bind T.Failures2, Mode=OneWay}" Tag="2"/>
                                                <ComboBoxItem Content="{x:Bind T.Failures3, Mode=OneWay}" Tag="3"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource SoftCardBorderStyle}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind T.MonitorStatus, Mode=OneWay}" FontSize="11" Opacity="0.5"/>
                                                <TextBlock x:Name="SmartAutoStatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{x:Bind T.RunNow, Mode=OneWay}" Click="SmartRunNow_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{x:Bind T.SmartExplain, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind T.TrayTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind T.TrayHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <ToggleSwitch x:Name="TrayEnabledToggle" Header="{x:Bind T.TrayToggle, Mode=OneWay}" Toggled="TrayEnabledToggle_Toggled"/>
                                    <ToggleSwitch x:Name="CloseToTrayToggle" Header="{x:Bind T.CloseToTray, Mode=OneWay}" Toggled="CloseToTrayToggle_Toggled"/>
                                    <InfoBar x:Name="ExitBehaviorInfo" IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="10"
                                             Title="{x:Bind T.ExitBehaviorTitle, Mode=OneWay}" Message="{x:Bind T.ExitBehaviorMessage, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind T.TrayExplain, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind T.CatalogTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind T.CatalogHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="{x:Bind T.AutoUpdateToggle, Mode=OneWay}" Toggled="AutoUpdateToggle_Toggled"/>
                                    <TextBlock Text="{x:Bind T.CatalogKeepCustom, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind T.UpdateUrlLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <TextBox x:Name="UpdateUrlBox" PlaceholderText="https://github.com/.../blob/main/dns.json" TextChanged="UpdateUrlBox_TextChanged" LostFocus="UpdateUrlBox_LostFocus" FlowDirection="LeftToRight" CornerRadius="8"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{x:Bind T.DefaultSource, Mode=OneWay}" Click="ResetGithubSource_Click" VerticalAlignment="Bottom" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind T.UpdateIntervalLabel, Mode=OneWay}" Opacity="0.62"/>
                                            <ComboBox x:Name="UpdateIntervalCombo" SelectionChanged="UpdateIntervalCombo_SelectionChanged" MinWidth="180">
                                                <ComboBoxItem Content="{x:Bind T.Hours6, Mode=OneWay}" Tag="6"/>
                                                <ComboBoxItem Content="{x:Bind T.Hours12, Mode=OneWay}" Tag="12"/>
                                                <ComboBoxItem Content="{x:Bind T.Hours24, Mode=OneWay}" Tag="24"/>
                                                <ComboBoxItem Content="{x:Bind T.Hours72, Mode=OneWay}" Tag="72"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="3">
                                            <TextBlock Text="{x:Bind T.DefaultSourceHint, Mode=OneWay}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="LastUpdateText" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{x:Bind T.CheckUpdate, Mode=OneWay}" Click="ManualUpdate_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="{x:Bind T.AddCustom, Mode=OneWay}" Click="AddCustomDns_Click" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind T.RestoreTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind T.RestoreHint, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" FontSize="12"/>
                                    <ToggleSwitch x:Name="RestoreOnExitToggle" Header="{x:Bind T.RestoreOnExit, Mode=OneWay}" Toggled="RestoreOnExitToggle_Toggled"/>
                                    <ToggleSwitch x:Name="CrashRecoveryToggle" Header="{x:Bind T.CrashRecovery, Mode=OneWay}" Toggled="CrashRecoveryToggle_Toggled"/>
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="10"
                                             Title="{x:Bind T.RestoreNoteTitle, Mode=OneWay}" Message="{x:Bind T.RestoreNoteMessage, Mode=OneWay}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{x:Bind T.RestoreAdapter, Mode=OneWay}" Click="Restore_Click" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        <Button Content="{x:Bind T.RestoreAll, Mode=OneWay}" Click="RestoreAll_Click" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind T.AboutTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{x:Bind T.AboutSubtitle, Mode=OneWay}" Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind T.AboutAuthor, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1" Content="t.me/sahandse" NavigateUri="https://t.me/sahandse" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="240">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <ProgressRing IsActive="True" Width="36" Height="36"/>
                                <TextBlock x:Name="BusyText" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
    </ContentControl>
</Window>
